# Application Admin Password
ADMIN_PASSWORD=admin123

# Session Encryption (32+ chars random string)
SESSION_SECRET=ecf3f28535c2993d8cb3053901e9c2c884450090a2011de87d17d289bd30f048

# Serverless Database (Turso / libSQL) - Recommended for Vercel
# Create a free database at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Local Database Path (Used for local development if Turso is not configured)
DATABASE_URL=./data/social-publisher.db

# API Key Encryption (64 hex characters / 32 bytes)
# IMPORTANT: Must be identical across environments to decrypt stored API keys
ENCRYPTION_KEY=36e2fdc7e919d390819193e349d42df042bcab2bd42461b3be107221fadee0b6

# Microsoft Graph API (OneDrive) - App Registration in Azure AD
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
